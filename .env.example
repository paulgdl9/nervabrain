# Optional: absolute or relative path to the Obsidian vault folder.
SECOND_BRAIN_VAULT=./vault

# Required in production: protects every write/automation endpoint.
CAPTURE_TOKEN=replace-with-random-token

# Gates the dashboard GUI itself (page views, not /api/*) behind a single
# shared password and a signed session cookie. Leave
# empty to keep today's behavior (no page-level auth) for local dev; a
# console warning is logged when the app runs without it.
DASHBOARD_PASSWORD=
# Optional: dedicated secret for signing the dashboard session cookie. If
# empty, CAPTURE_TOKEN is reused, then DASHBOARD_PASSWORD itself as a last
# resort. Set your own random value for a cleaner secret boundary.
SESSION_SECRET=
# Public base URL used by the MCP OAuth metadata endpoint.
# Set to the public URL of your instance, e.g. https://brain.example.com
NEXT_PUBLIC_MCP_BASE_URL=
# Comma-separated browser origins allowed to call OAuth/MCP endpoints via CORS.
# NEXT_PUBLIC_MCP_BASE_URL's origin is added automatically. For the Claude app
# connector, include https://claude.ai and https://claude.com.
MCP_ALLOWED_ORIGINS=

# Where OAuth clients and token hashes are persisted across restarts.
# Defaults to ./data/oauth-state.json (mounted as a volume in docker-compose).
OAUTH_STATE_FILE=

# Where assistant chat conversations are stored as JSON files, one per
# conversation, so every device shares the same history. Defaults to
# ./data/assistant-chats (inside the shared data volume in docker-compose).
ASSISTANT_CHATS_DIR=

# Optional for direct LAN/VPN dashboard access. Localhost and requests carrying
# a *cryptographically verified* Cloudflare Access assertion (see CF_ACCESS_*
# below) always work without it. When set to true, this ALSO trusts browser
# POSTs whose Origin and Sec-Fetch-Site prove they are same-origin — which only
# holds if nothing untrusted can reach the origin port directly. Default is
# false: enabling it assumes a trusted network perimeter around the app.
ALLOW_SAME_ORIGIN_WRITES=false

# Cloudflare Access JWT verification. When BOTH are set, a request carrying a
# `cf-access-jwt-assertion` header signed by your team and matching this AUD is
# trusted for dashboard writes even when ALLOW_SAME_ORIGIN_WRITES=false. Leave
# either empty to disable: the header is then never trusted (its mere presence
# is forgeable), and only loopback / opted-in same-origin writes are allowed.
#   CF_ACCESS_TEAM_DOMAIN: your team name or "<team>.cloudflareaccess.com".
#     JWKS is fetched from https://<team>.cloudflareaccess.com/cdn-cgi/access/certs
#   CF_ACCESS_AUD: the Application Audience (AUD) tag from the Access app.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

NEXT_PUBLIC_APP_NAME=Nerva Brain
TIMEZONE=UTC

# Docker runtime identity. Match the owner of the mounted vault.
SECOND_BRAIN_UID=1000
SECOND_BRAIN_GID=1000

# Host bind for the web app (127.0.0.1 = local only; use a LAN/VPN IP for direct access).
SECOND_BRAIN_BIND=127.0.0.1
# Host port for this profile. Use a different value for every profile sharing
# the same machine (for example 3000 and 3001).
SECOND_BRAIN_PORT=3000

# Subscription plan for this tenant: free | plus | pro. Gates the features that
# spend the operator's AI budget — free tenants get deterministic briefs and no
# in-app assistant (they use their own Claude via the MCP connector), plus adds
# hosted AI + a metered Sonnet assistant, pro adds an unmetered Opus assistant,
# Garmin, and backups. Unset defaults to pro so a single-tenant deploy keeps
# every feature. ASSISTANT_MONTHLY_QUOTA overrides the plus fair-use ceiling.
# SECOND_BRAIN_PLAN=pro
# ASSISTANT_MONTHLY_QUOTA=200

# Optional revision program location inside this profile's vault. The setup
# wizard creates a generic program at these defaults when Revisions is enabled.
REVISION_PROJECT_DIR=08-Projects/Revisions
REVISION_PROGRAM_FILE=Programme-Revisions.md

# Optional public exposure via this project's OWN Cloudflare tunnel.
# Create a tunnel in the Cloudflare Zero Trust dashboard, route its hostname to
# http://second-brain:3000, paste the token here, then:
#   docker compose --profile tunnel up -d
CLOUDFLARED_TOKEN=

# RSS auto-ingest. Feeds are managed in the app (/feeds) and stored in 00-System/Feeds.md.
# On first run the feed list is seeded from WATCH_RSS_FEEDS here; if empty, no
# feeds are seeded (add them in the app). Comma-separated feed URLs.
WATCH_RSS_FEEDS=
# Background poll interval in minutes (0 disables the in-app scheduler).
RSS_POLL_MINUTES=30
# How many newest items to import the first time a feed is seen (avoids flooding the inbox with history).
RSS_INITIAL_IMPORT=3
# Maximum new items imported per feed on every later poll.
RSS_MAX_IMPORT_PER_FEED=3

# AI bridge (bundled in ./bridge). It powers AI inbox processing, daily briefs,
# weekly reviews, and semantic task deduplication, following the provider and
# model order saved during setup. This bridge is self-contained: no other
# project is required.
# If MEMO_TOKEN is empty or the bridge is down, the app uses the deterministic
# local fallback instead.
#
# MEMO_PORT and MEMO_BRIDGE_URL are only used by an explicit local-development
# bridge. Docker Compose keeps the production bridge private at ai-bridge:8089.
# MEMO_TOKEN: shared secret between the app and its bridge. Generate your own.
MEMO_PORT=8089
MEMO_BRIDGE_URL=http://127.0.0.1:8089
MEMO_TOKEN=
# Optional location of API keys saved by the setup wizard. Empty defaults to
# ./data/ai-credentials.env. A relative value (for example private/ai.env or
# data/private/ai.env) is resolved inside the shared ./data volume by both the
# app and AI bridge. The file is mode 0600 and ignored by Git.
AI_CREDENTIALS_FILE=
# Optional local-development CLI overrides. Production CLIs are in Dockerfile.ai.
CLAUDE_BIN=
CODEX_BIN=
# Optional local-development bind address. Access is always gated by MEMO_TOKEN.
MEMO_BIND=0.0.0.0
# Maximum number of simultaneous AI subprocesses. Additional requests wait.
MEMO_MAX_CONCURRENCY=2
# Optional: areas the AI may assign, and weekly-review output language.
MEMO_AREAS=Work,Projects,Finance,Health,Learning,Personal,Knowledge
WEEKLY_LANGUAGE=French
# Optional models (empty = built-in defaults).
BRIEF_MODEL=
PROCESS_MODEL=
WEEKLY_MODEL=
CHAT_MODEL=
AI_BRIEF_TIMEOUT_MS=480000
AI_PROCESS_TIMEOUT_MS=180000
AI_PROCESS_CONCURRENCY=2
AI_WEEKLY_TIMEOUT_MS=480000
AI_CHAT_TIMEOUT_MS=330000
# Bridge engine wall-clock budget in seconds — keep it under the AI_*_TIMEOUT_MS
# values above or the app gives up before the bridge answers. On slow hardware
# (Raspberry Pi) the primary engine alone can need 3-4 minutes for a full brief.
BRIEF_BUDGET=400
# Chat assistant engine budget (seconds); keep it under AI_CHAT_TIMEOUT_MS above.
CHAT_BUDGET=300

# Optional encrypted profile backup. With the default repository, snapshots
# are stored in ./backups; mount that directory from another disk for hardware
# protection, or set RESTIC_REPOSITORY to an S3/SFTP/rest server destination.
# Start explicitly with: docker compose --profile backup up -d backup
RESTIC_REPOSITORY=/backup
RESTIC_PASSWORD=
BACKUP_INTERVAL_SECONDS=86400

# Garmin Connect is also profile-isolated. Tokens live in data/garmin and are
# never added to the image or Git. The generic script reads the objective from
# the profile vault. A legacy profile can explicitly select its older script.
GARMIN_SYNC_SCRIPT=/sync/garmin-sync-profile.py
GARMIN_SYNC_TIMES=06:40,21:40
